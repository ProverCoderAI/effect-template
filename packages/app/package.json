{
  "name": "@effect-template/app",
  "version": "1.0.14",
  "description": "Minimal Vite-powered TypeScript console starter using Effect",
  "main": "dist/main.js",
  "directories": {
    "doc": "doc"
  },
  "scripts": {
    "build": "vite build --ssr src/app/main.ts",
    "dev": "vite build --watch --ssr src/app/main.ts",
    "lint": "npx @ton-ai-core/vibecode-linter src/",
    "lint:tests": "npx @ton-ai-core/vibecode-linter tests/",
    "lint:effect": "npx eslint --config eslint.effect-ts-check.config.mjs .",
    "check": "pnpm run typecheck",
    "prestart": "pnpm run build",
    "start": "node dist/main.js",
    "test": "pnpm run lint:tests && vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProverCoderAI/effect-template.git"
  },
  "keywords": [
    "effect",
    "typescript",
    "vite",
    "console"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/ProverCoderAI/effect-template/issues"
  },
  "homepage": "https://github.com/ProverCoderAI/effect-template#readme",
  "packageManager": "pnpm@12.3.4",
  "dependencies": {
    "@effect/cli": "^0.77.0",
    "@effect/cluster": "^0.60.2",
    "@effect/experimental": "^0.61.1",
    "@effect/platform": "^0.97.1",
    "@effect/platform-node": "^0.108.1",
    "@effect/printer": "^0.51.0",
    "@effect/printer-ansi": "^0.51.0",
    "@effect/rpc": "^0.76.2",
    "@effect/schema": "^0.75.5",
    "@effect/sql": "^0.52.1",
    "@effect/typeclass": "^0.41.0",
    "@effect/workflow": "^0.19.1",
    "effect": "^3.22.1",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@effect/eslint-plugin": "^0.3.2",
    "@effect/language-service": "latest",
    "@effect/vitest": "^0.30.0",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/compat": "2.1.1",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "10.0.1",
    "@prover-coder-ai/eslint-plugin-suggest-members": "^0.0.26",
    "@ton-ai-core/vibecode-linter": "^1.0.11",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.69.0",
    "typescript-eslint": "^8.69.0",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-codegen": "0.34.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-sort-destructure-keys": "^3.0.0",
    "eslint-plugin-unicorn": "^74.0.0",
    "@vitest/eslint-plugin": "^1.6.27",
    "globals": "^17.12.0",
    "jscpd": "^5.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.0"
  }
}
